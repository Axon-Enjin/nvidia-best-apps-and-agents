# Remote inference requires explicit online mode as well as a credential.
# Offline is the default, even when a provider credential is present.
NETWORK_MODE=offline
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Lightweight local development defaults. Standard PostgreSQL packaging is planned.
# Relative paths below resolve against WORKSPACE_ROOT (default: the repository root), not the working directory.
# WORKSPACE_ROOT=
DATABASE_URL=sqlite:///data/sentinel.db
APP_ENV=development
# Named accounts are required by default. Provision with python -m sentinel account-create.
AUTH_MODE=named
SECRET_KEY_FILE=data/account.key
SOURCE_STORAGE_ROOT=data/sources
# Set true behind local HTTPS; production requires HTTPS and secure cookies.
SECURE_COOKIES=false
# Development migration ONLY: AUTH_MODE=legacy also requires a token of at least 24 characters.
APP_ACCESS_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
EMBEDDED_WORKER=true
AUTO_MIGRATE=true
PORT=8000
